{{- /* Per-machine data. Nothing here is committed: chezmoi renders it to ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name := or (env "OMACHY_NAME") (env "GIT_AUTHOR_NAME") -}}
{{- if not $name -}}{{- $name = promptStringOnce . "name" "Git author name" -}}{{- end -}}
{{- $email := or (env "OMACHY_EMAIL") (env "GIT_AUTHOR_EMAIL") -}}
{{- if not $email -}}{{- $email = promptStringOnce . "email" "Git author email" -}}{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}

[diff]
  pager = "delta"
