#!/usr/bin/env bash
# theme — switch the whole desktop theme at once (Omarchy-style).
#   theme            pick with fzf
#   theme <name>     apply a theme
#   theme --list     list themes
#   theme --current  print the active theme
set -euo pipefail

OMA="$HOME/.config/omacy"
THEMES="$OMA/themes"
list() { for d in "$THEMES"/*/; do basename "$d"; done; }

case "${1:-}" in
  -l | --list) list; exit 0 ;;
  -c | --current) basename "$(readlink "$OMA/current" 2>/dev/null || echo none)"; exit 0 ;;
  -h | --help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
  "") name=$(list | fzf --prompt '🎨 ' --height 40% --reverse) || exit 0 ;;
  *) name=$1 ;;
esac

[[ -f $THEMES/$name/theme.env ]] || { echo "theme: unknown theme '$name' (have: $(list | xargs))" >&2; exit 1; }
ln -sfn "$THEMES/$name" "$OMA/current"
# shellcheck disable=SC1091
source "$OMA/current/theme.env"

# Ghostty — SIGUSR2 reloads config in every window.
printf 'theme = %s\n' "$GHOSTTY_THEME" >"$HOME/.config/ghostty/theme.conf"
pkill -USR2 -x ghostty 2>/dev/null || true

# Neovim — retheme every running instance.
for sock in "${TMPDIR%/}/nvim.$USER"/*/nvim.*.0; do
  [[ -S $sock ]] && nvim --server "$sock" --remote-send "<Cmd>colorscheme $NVIM_COLORSCHEME<CR>" >/dev/null 2>&1 || true
done

# btop
btop_conf="$HOME/.config/btop/btop.conf"
mkdir -p "${btop_conf%/*}"
if [[ -f $btop_conf ]] && grep -q '^color_theme' "$btop_conf"; then
  sed -i '' "s|^color_theme = .*|color_theme = \"$BTOP_THEME\"|" "$btop_conf"
else
  echo "color_theme = \"$BTOP_THEME\"" >>"$btop_conf"
fi

# Bar + borders
command -v sketchybar >/dev/null && sketchybar --reload >/dev/null 2>&1 || true
pgrep -xq borders && "$HOME/.config/borders/bordersrc" >/dev/null 2>&1 || true

# Wallpaper (real path, not the symlink, so macOS notices the change).
osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$THEMES/$name/wallpaper.jpg\"" >/dev/null 2>&1 || true

echo "🎨 $THEME_NAME"
