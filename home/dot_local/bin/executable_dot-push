#!/usr/bin/env bash
# dot-push <ssh-host> [--offline|--online]
# Ship the terminal setup (zsh, tmux, nvim+LazyVim, CLI tools) to a remote Linux host or Coder workspace.
# Never needs root; everything lands in ~/.local and ~/.config on the remote.
#   - Online remote : copies the repo, remote downloads its own tools (chezmoi + mise).
#   - Offline remote: builds a Linux bundle here (binaries + plugins) and ships it.
set -euo pipefail

host=${1:?usage: dot-push <ssh-host> [--offline|--online]}
mode=${2:-auto}
REPO="$(chezmoi source-path)/.."
REPO="$(cd "$REPO" && pwd)"
CACHE="$HOME/.cache/omacy"
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

name=$(chezmoi data --format json | jq -r .name)
email=$(chezmoi data --format json | jq -r .email)

log "$host: probing"
read -r arch online < <(ssh "$host" 'printf "%s " "$(uname -m)"; curl -fsS -m 6 -o /dev/null https://github.com && echo yes || echo no')
[[ $mode == --offline ]] && online=no
[[ $mode == --online ]] && online=yes
log "$host: arch=$arch internet=$online"

log "Copying repo"
ssh "$host" 'mkdir -p ~/.local/share/omacy'
rsync -az --delete --exclude .git --exclude '*.jpg' "$REPO/" "$host:.local/share/omacy/"

if [[ $online == yes ]]; then
  ssh -t "$host" "OMACY_NAME='$name' OMACY_EMAIL='$email' bash ~/.local/share/omacy/install.sh --minimal"
  exit 0
fi

# --- Offline bundle: download the Linux tools here, ship them -------------------------------
# shellcheck disable=SC1091
source "$REPO/scripts/linux-tools.sh"
B="$CACHE/bundle-linux-$arch"
rm -rf "$B" && mkdir -p "$B/share/nvim" "$B/share/zsh" "$B/share/tmux"

log "Building offline bundle for linux/$arch"
omacy_linux_tools "$B" "$arch"

# Plugins are plain Lua/shell — portable from this Mac.
cp -R "$HOME/.local/share/nvim/lazy" "$B/share/nvim/lazy"
cp -R "$HOME/.local/share/zsh/plugins" "$B/share/zsh/plugins"
cp -R "$HOME/.local/share/tmux/plugins" "$B/share/tmux/plugins"

log "Shipping bundle ($(du -sh "$B" | cut -f1))"
rsync -az --delete "$B/" "$host:.local/share/omacy-bundle/"
ssh -t "$host" "OMACY_NAME='$name' OMACY_EMAIL='$email' bash ~/.local/share/omacy/install.sh --minimal --offline"
