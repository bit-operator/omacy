# omamac ssh config. Hosts live in ~/.ssh/config.d/:
#   coder   — generated by `coder config-ssh`
#   work    — company hosts (internal dotfiles layer)
#   local   — personal / machine-only hosts (untracked)
Include config.d/*

Host *
  ServerAliveInterval 30
  ServerAliveCountMax 4
  # Reuse one connection per host: instant repeat ssh/scp/rsync, one Touch ID prompt.
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes
